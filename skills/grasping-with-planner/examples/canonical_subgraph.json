{
  "skill": "grasping-with-planner",
  "inputs": {
    "target_obb": "OrientedBoundingBox",
    "target_mask": "Mask",
    "target_observation": "Observation",
    "target_lineage_json": "str",
    "target_name": "str",
    "preset_json": "str"
  },
  "nodes": {
    "build_world": {
      "type": "script",
      "script": "scripts/build_world.py",
      "inputs": {
        "observation": {"$ref": "in.target_observation"},
        "target_mask": {"$ref": "in.target_mask"},
        "target_obb": {"$ref": "in.target_obb"},
        "target_name": {"$ref": "in.target_name"}
      }
    },
    "plan": {
      "type": "script",
      "script": "scripts/plan_validate_grasp.py",
      "inputs": {
        "target_obb": {"$ref": "in.target_obb"},
        "target_lineage_json": {"$ref": "in.target_lineage_json"},
        "world_config": {"$ref": "build_world.config"},
        "target_name": {"$ref": "in.target_name"},
        "preset_json": {"$ref": "in.preset_json"}
      }
    },
    "execute": {
      "type": "script",
      "script": "scripts/execute_verify_grasp.py",
      "inputs": {
        "validated_grasp_json": {"$ref": "plan.validated_grasp_json"},
        "target_lineage_json": {"$ref": "in.target_lineage_json"},
        "world_config": {"$ref": "build_world.config"},
        "target_name": {"$ref": "in.target_name"},
        "preset_json": {"$ref": "in.preset_json"}
      }
    },
    "done": {"type": "noop"},
    "rejected": {"type": "noop"}
  },
  "edges": [
    ["START", "build_world"],
    ["build_world", "plan"],
    ["done", "END"],
    ["rejected", "END"]
  ],
  "conditional_edges": {
    "plan": {
      "router_field": "success",
      "mapping": {"True": "execute", "False": "rejected"}
    },
    "execute": {
      "router_field": "success",
      "mapping": {"True": "done", "False": "rejected"}
    }
  },
  "outputs": {
    "held_grasp_json": {"$ref": "execute.held_grasp_json"},
    "world_config": {"$ref": "build_world.config"}
  },
  "exit": {"router_field": null, "success_values": ["done", "rejected"]},
  "on_error": "error"
}
