{
  "skill": "perceiving-objects",
  "inputs": {
    "query": "str",
    "semantic_role": "str",
    "preset_json": "str"
  },
  "nodes": {
    "perceive": {
      "type": "script",
      "script": "scripts/perceive_disambiguate_segment.py",
      "inputs": {
        "query": {"$ref": "in.query"},
        "semantic_role": {"$ref": "in.semantic_role"},
        "preset_json": {"$ref": "in.preset_json"}
      }
    },
    "done": {"type": "noop"},
    "rejected": {"type": "noop"}
  },
  "edges": [
    ["START", "perceive"],
    ["done", "END"],
    ["rejected", "END"]
  ],
  "conditional_edges": {
    "perceive": {
      "router_field": "success",
      "mapping": {"True": "done", "False": "rejected"}
    }
  },
  "outputs": {
    "destination_obb": {"$ref": "perceive.destination_obb"},
    "destination_lineage_json": {"$ref": "perceive.lineage_json"}
  },
  "exit": {"router_field": null, "success_values": ["done", "rejected"]},
  "on_error": "error"
}
